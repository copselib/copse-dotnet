<Project>

  <!--
    Shared build & packaging settings for every project under src/.
    Individual shippable projects opt in with <IsPackable>true</IsPackable> and a <Description>.
    Version is derived from git tags by MinVer (tag "v0.1.0-alpha.1" => package "0.1.0-alpha.1");
    do NOT add <Version>/<VersionPrefix> anywhere.
  -->

  <PropertyGroup>
    <!-- Nothing ships unless a project explicitly opts in. -->
    <IsPackable>false</IsPackable>

    <!-- Docs generate for EVERY project (the SDK derives DocumentationFile at props time, so
         this cannot be conditioned on IsPackable, which projects set later). The CS1591
         policy lives in Directory.Build.targets, where IsPackable IS visible: error on
         shippable projects, suppressed elsewhere. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- LangVersion is DELIBERATELY not set here (2026-08-15). The async projects pin 13
         (single-target sources, modern C#); the multi-target sync projects stay unpinned so
         each TFM gets its default, which makes the net48/netstandard2.0 legs compile as
         C# 7.3 and thereby ENFORCE that the codegen transform emits 7.3-compatible twins.
         Pinning 13 family-wide would silently remove that enforcement: the old legs would
         accept modern syntax and fail only at runtime or never. The generated code's
         downlevel compatibility is guarded by the build itself; keep it that way. -->

    <!-- Shared package metadata. -->
    <Authors>Jason Boyd</Authors>
    <Copyright>Copyright (c) 2023-2026 Jason Boyd</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/copselib/copse-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/copselib/copse-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>tree traversal linq treenumerable depth-first breadth-first monad tree-data-structure</PackageTags>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- TODO: add PackageIcon once an icon asset is committed (intentionally uncommitted for now). -->

    <!-- MinVer: git tag is the single source of truth for the version. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!-- SourceLink + deterministic/symbol settings for good packages. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Pack the repo-root README into every package (shown on the nuget.org package page).
       Inert for non-packable projects, which are never packed. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- Third-party attributions (lifted System.Reactive disposables) ship in every package. -->
    <None Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Allow net48 to build on any platform (Linux/macOS CI included). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
