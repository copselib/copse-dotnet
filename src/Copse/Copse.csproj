<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>The concrete treenumerables for Copse: the depth-first/breadth-first engine over the child-pull protocol, the flat family (preorder/level-order store and stream decoders), the tree-source factories (Tree.Defer/Lazy/Using/Empty), and the wrapper bases.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Copse.Core\Copse.Core.csproj" />
    <ProjectReference Include="..\Copse.Primitives\Copse.Primitives.csproj" />
    <!-- Shared sans-I/O DFT path state (DepthFirstPathState); the direct-style DepthFirstDirectTreenumerator drives it. -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Copse.Tests" />
    <InternalsVisibleTo Include="Copse.Linq" />
    <InternalsVisibleTo Include="Copse.Async" />
    <InternalsVisibleTo Include="Copse.Async.Tests" />
    <InternalsVisibleTo Include="Copse.Benchmarks" />
    <InternalsVisibleTo Include="Copse.Linq.Experimental" />
    <InternalsVisibleTo Include="Copse.Linq.Tests" />
    <InternalsVisibleTo Include="Copse.TestUtils" />
    <InternalsVisibleTo Include="Copse.Trees" />
  </ItemGroup>
</Project>
