<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>13</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>Async contracts for Copse: IAsyncTreenumerable (and its two single-dimension parents) and IAsyncTreenumerator plus the async walker tier (AsyncTreeWalker, IAsyncTreeTopology, IAsyncWalkableTreenumerable) -- the awaited-pull duals of Copse.Core, sharing its traversal vocabulary.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Copse.Core\Copse.Core.csproj" />
  </ItemGroup>

  <!-- No InternalsVisibleTo (2026-08-15): the seal lives at the SUBSTRATE boundary, not
       here: TreeWalker.Topology is public (the vantage's bound-physics half; a topology
       navigates relative to any handle, a walker relative to its focus; the signatures
       carry the frame), and what stays hidden is the STORE behind each topology
       (implementations sealed, accessors internal, wholesale views read-only). The
       operator tier and third parties hold identical access. -->

  <!-- netstandard2.1 and net8.0 have IAsyncEnumerable/IAsyncDisposable/ValueTask in-box; net48 and
       netstandard2.0 get them from the Microsoft polyfill (System.Threading.Tasks.Extensions rides
       along transitively). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48' OR '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

</Project>
