<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>The synchronous traversal contracts for Copse (ITreenumerator, ITreenumerable and its dimension-split parents), over the shared Copse.Vocabulary.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The color-agnostic vocabulary (NodePosition, the enums, NodeVisit); shared with the async core. -->
    <ProjectReference Include="..\Copse.Vocabulary\Copse.Vocabulary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Family IVT (the store-policy precedent, 2026-08-14): the walker's Terrain field is
         internal so consumers meet ONE navigation spelling; the comonad extensions in the
         operator tier are the sanctioned readers. Lockstep packaging makes this skew-safe. -->
    <InternalsVisibleTo Include="Copse.Linq" />
    <InternalsVisibleTo Include="Copse.Linq.Tests" />
  </ItemGroup>

</Project>
